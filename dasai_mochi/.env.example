# ================================================================
# Dasai Mochi Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
# ================================================================

# ============ WEATHER API CONFIGURATION ============
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_GEO_URL=http://api.openweathermap.org/geo/1.0
WEATHER_UNITS=metric
WEATHER_LANGUAGE=en

# Alternative Weather Service
WEATHERBIT_API_KEY=your_weatherbit_api_key_here
WEATHERBIT_BASE_URL=https://api.weatherbit.io/v2.0

# ============ AI/ML SERVICE KEYS ============
# OpenAI API - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_ORGANIZATION_ID=your_openai_org_id_here

# Google AI Platform
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_PROJECT_ID=your_google_project_id_here

# Azure Cognitive Services
AZURE_COGNITIVE_KEY=your_azure_cognitive_key_here
AZURE_COGNITIVE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_COGNITIVE_REGION=eastus

# ============ CLOUD STORAGE & DATABASE ============
# Firebase Configuration - Get from Firebase Console
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:android:abcdef123456
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ============ NOTIFICATION SERVICES ============
# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=123456789012

# OneSignal - Get from OneSignal Dashboard
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_key_here

# Pusher
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_KEY=your_pusher_key_here
PUSHER_SECRET=your_pusher_secret_here
PUSHER_CLUSTER=mt1

# ============ BLE & ESP32 CONFIGURATION ============
# ESP32 Device Configuration
ESP32_SERVICE_UUID=12345678-1234-1234-1234-123456789abc
ESP32_WRITE_CHAR_UUID=12345678-1234-1234-1234-123456789abd
ESP32_NOTIFY_CHAR_UUID=12345678-1234-1234-1234-123456789abe
ESP32_DEFAULT_NAME=DasaiMochi
ESP32_FIRMWARE_UPDATE_URL=https://your-domain.com/firmware

# ============ VOICE & SPEECH SERVICES ============
# Google Speech-to-Text
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here
GOOGLE_SPEECH_PROJECT_ID=your_google_project_id_here

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# IBM Watson Speech
IBM_SPEECH_API_KEY=your_ibm_watson_api_key_here
IBM_SPEECH_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ============ MUSIC & AUDIO SERVICES ============
# Spotify API - Get from Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=https://your-app.com/callback

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# SoundCloud
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here

# ============ ANALYTICS & MONITORING ============
# Google Analytics
GOOGLE_ANALYTICS_TRACKING_ID=UA-123456789-1
GOOGLE_ANALYTICS_4_ID=G-XXXXXXXXXX

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token_here

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============ BACKEND API ENDPOINTS ============
# Your Backend API
API_BASE_URL=https://api.dasaimochi.com
API_VERSION=v1
API_TIMEOUT=30000

# Authentication Service
AUTH_BASE_URL=https://auth.dasaimochi.com
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h

# ============ SOCIAL MEDIA APIS ============
# Twitter API
TWITTER_CONSUMER_KEY=your_twitter_consumer_key_here
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_token_secret_here

# Facebook API
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ============ PAYMENT SERVICES ============
# Stripe - Get from Stripe Dashboard
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# ============ MAP & LOCATION SERVICES ============
# Google Maps - Get from Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ============ SMS & COMMUNICATION ============
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@dasaimochi.com

# ============ APP CONFIGURATION ============
# Basic App Settings
APP_NAME=Dasai Mochi
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=development
DEBUG_MODE=true
LOG_LEVEL=debug

# Security Configuration (Generate random 32-character strings)
ENCRYPTION_KEY=your_32_character_encryption_key_here
HASH_SALT=your_hash_salt_here
SESSION_SECRET=your_session_secret_here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============ DEVELOPMENT TOOLS ============
# CodePush (for React Native/Flutter)
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_codepush_android_key_here
CODEPUSH_DEPLOYMENT_KEY_IOS=your_codepush_ios_key_here

# Bugfender
BUGFENDER_API_KEY=your_bugfender_api_key_here

# ============ CUSTOM ESP32 SERVICES ============
# OTA Update Configuration
OTA_SERVER_URL=https://your-domain.com/ota
OTA_FIRMWARE_VERSION=1.0.0
OTA_CHECK_INTERVAL=3600

# Device Management
DEVICE_REGISTRY_URL=https://your-domain.com/device-registry
DEVICE_TELEMETRY_URL=https://your-domain.com/telemetry

# Time Synchronization
NTP_SERVER_1=pool.ntp.org
NTP_SERVER_2=time.google.com
TIMEZONE_OFFSET=0