# ================================================================
# Dasai Mochi - Security and Build Artifacts Exclusions
# ================================================================

# ============ SECURITY & SENSITIVE DATA ============
# Environment files with sensitive data
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
*.env
env.json
environment.json

# API Keys and Secrets
**/secrets/
**/keys/
**/credentials/
**/*key*.json
**/*secret*.json
**/*config*.json
**/firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Certificate and Keystore files
*.p12
*.p8
*.mobileprovision
*.keystore
*.jks
*.pem
*.crt
*.der
*.pfx

# Private keys
id_rsa
id_ed25519
*.private
private_key*
*_private_key*

# ============ FLUTTER & DART SPECIFIC ============
# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
pubspec_overrides.yaml

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart
*.chopper.dart
*.config.dart
l10n.dart

