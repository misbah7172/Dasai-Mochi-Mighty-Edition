# ================================================================
# ESP32 Firmware Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ================================================================

# ============ WiFi Configuration ============
WIFI_SSID=your_wifi_network_name
WIFI_PASSWORD=your_wifi_password
WIFI_TIMEOUT=10000

# ============ BLE Configuration ============
# BLE Service UUIDs
BLE_SERVICE_UUID=12345678-1234-1234-1234-123456789abc
BLE_WRITE_CHAR_UUID=12345678-1234-1234-1234-123456789abd
BLE_NOTIFY_CHAR_UUID=12345678-1234-1234-1234-123456789abe

# Device Information
DEVICE_NAME=DasaiMochi
DEVICE_MANUFACTURER=Dasai Labs
DEVICE_MODEL=Mochi-v1.0
DEVICE_SERIAL=MOCHI001

# ============ Cloud Services ============
# Backend API Configuration
API_BASE_URL=https://api.dasaimochi.com
API_KEY=your_api_key_here
API_TIMEOUT=30000

# MQTT Broker (if using MQTT for IoT communication)
MQTT_SERVER=your-mqtt-broker.com
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=dasai_mochi_

# ============ OTA Updates ============
# Over-The-Air Update Configuration
OTA_SERVER_URL=https://your-domain.com/ota
OTA_FIRMWARE_VERSION=1.0.0
OTA_CHECK_INTERVAL=3600
OTA_DOWNLOAD_TIMEOUT=60000

# ============ Time Synchronization ============
# NTP Server Configuration
NTP_SERVER_1=pool.ntp.org
NTP_SERVER_2=time.google.com
NTP_SERVER_3=time.cloudflare.com
TIMEZONE_OFFSET=0
DST_ENABLED=true

# ============ Security Configuration ============
# Encryption Keys (Generate random keys)
DEVICE_ENCRYPTION_KEY=your_32_byte_encryption_key_here
DEVICE_AUTH_TOKEN=your_device_authentication_token
PAIRING_PIN=1234

# Certificate for HTTPS/TLS
ROOT_CA_CERT=your_root_ca_certificate_here

# ============ Sensor Configuration ============
# Battery Management
BATTERY_LOW_THRESHOLD=20
BATTERY_CRITICAL_THRESHOLD=10
BATTERY_CALIBRATION_FACTOR=1.0

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_BIT_DEPTH=16
AUDIO_CHANNELS=1
MICROPHONE_GAIN=50
SPEAKER_VOLUME=75

# Display Configuration
OLED_BRIGHTNESS=128
OLED_CONTRAST=255
SCREEN_TIMEOUT=30000

# ============ Notification Settings ============
# Vibration Motor
VIBRATION_INTENSITY=200
VIBRATION_DURATION=500

# LED Configuration
LED_BRIGHTNESS=100
LED_ANIMATION_SPEED=500

# ============ Development Settings ============
# Debug Configuration
DEBUG_MODE=true
SERIAL_BAUD_RATE=115200
LOG_LEVEL=DEBUG

# Watchdog Timer
WATCHDOG_TIMEOUT=30000
WATCHDOG_ENABLED=true

# ============ Memory Management ============
# Storage Configuration
SPIFFS_SIZE=1048576
LITTLEFS_SIZE=2097152
MAX_LOG_SIZE=65536
MAX_REMINDERS=50
MAX_AUDIO_FILES=20

# ============ Network Configuration ============
# HTTP Client Configuration
HTTP_TIMEOUT=10000
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1000

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=30000
WEBSOCKET_RECONNECT_INTERVAL=5000

# ============ Power Management ============
# Sleep Configuration
DEEP_SLEEP_ENABLED=true
LIGHT_SLEEP_TIMEOUT=300000
DEEP_SLEEP_TIMEOUT=3600000

# CPU Frequency
CPU_FREQUENCY=240
CPU_LOW_POWER_MODE=false

# ============ Hardware Pins ============
# GPIO Pin Configuration (ESP32 specific)
PIN_I2C_SDA=21
PIN_I2C_SCL=22
PIN_SPI_MISO=19
PIN_SPI_MOSI=23
PIN_SPI_CLK=18
PIN_SPI_CS=5

# Audio Pins
PIN_I2S_BCLK=26
PIN_I2S_LRC=25
PIN_I2S_DIN=22
PIN_I2S_DOUT=27

# Control Pins
PIN_BUTTON_1=0
PIN_BUTTON_2=35
PIN_LED_STATUS=2
PIN_VIBRATION_MOTOR=4
PIN_BATTERY_ADC=36